{
  "name": "power-le-jeu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --outfile=public/app.js --format=esm --target=es2020 && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test": "tsx src/shared/rules.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "esbuild": "^0.24.0", "tsx": "^4.19.0", "typescript": "^5.6.0", "@types/ws": "^8.5.12", "@types/node": "^22.0.0" }
}
